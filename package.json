{
  "name": "busan-v42-travel-app",
  "version": "42.0.0",
  "description": "BUSAN Ultimate Travel Platform V42 - Production-grade PWA",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "playwright test",
    "test:critical": "playwright test tests/critical.spec.js",
    "test:ux": "playwright test tests/ux.spec.js",
    "test:travel": "playwright test tests/travel.spec.js",
    "test:accessibility": "playwright test tests/accessibility.spec.js",
    "test:offline": "playwright test tests/offline.spec.js",
    "test:chromium": "playwright test --project=chromium",
    "test:firefox": "playwright test --project=firefox",
    "test:webkit": "playwright test --project=webkit",
    "report": "playwright show-report",
    "serve": "serve -s . -l 8080",
    "lint:js": "node scripts/syntax-check.js",
    "verify:fast": "playwright test --config=playwright.fast.config.js",
    "verify:full": "playwright test --config=playwright.config.js",
    "verify:production": "playwright test --config=playwright.production.config.js"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "serve": "^14.2.3"
  }
}
